#!/bin/zsh
# The bundle's executable. Everything it does is in the python probe; this bundle
# exists only so the calendar read has a BUNDLE IDENTITY, which is what macOS
# requires before it will show a permission prompt at all. A bare python binary
# has none, so the request returns denied WITHOUT prompting and the app never
# appears in Privacy & Security — which is exactly what happened on 2026-08-13.
#
# It logs rather than prints because `open` gives a bundle no terminal to print to.
REPO="${CARR_REPO:-$HOME/carr-system}"
LOG="$REPO/out/calendar-access.log"
mkdir -p "$REPO/out"
{
  print -r -- "--- $(date -u +%FT%TZ) CARR Calendar Access ---"
  "$REPO/.venv/bin/python" "$REPO/tools/calendar-attendee-probe.py" "$@" 2>&1
  print -r -- "exit=$?"
} >> "$LOG"
