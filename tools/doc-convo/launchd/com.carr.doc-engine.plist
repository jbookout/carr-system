<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.carr.doc-engine</string>
  <!-- Explicit interpreter: launchd's PATH resolves python3 to macOS's
       system 3.9, which cannot parse modern type syntax (found 2026-08-08). -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/booko/carr-system/tools/doc-convo/bin/convo-server.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/booko/carr-system/tools/doc-convo/bin</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/doc-engine.log</string>
  <key>StandardErrorPath</key><string>/tmp/doc-engine.log</string>
</dict>
</plist>
