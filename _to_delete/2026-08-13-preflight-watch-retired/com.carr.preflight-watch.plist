<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.carr.preflight-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/preflight-watch.sh</string>
  </array>
  <key>WorkingDirectory</key><string>{{REPO}}</string>
  <!-- TEMPORARY BY DESIGN, and it deletes itself. It guards Dell's migration
       packet until he runs it, then unloads and removes this file on the run
       that first sees action-required A15 closed. Nothing else has to remember
       to clean it up, which is the whole reason it exists: Joe, 2026-08-10,
       "im not going to remember that."

       07:15 daily, plus RunAtLoad so installing it produces an answer straight
       away rather than tomorrow. Before the workday and before any drive to
       Dell's, and off the top of the hour so it does not queue behind the 7:00
       rules-refresh. Once per day is the right rate: it is watching for a
       regression pushed by another lane, and the check costs ~55s of clone and
       selftest. It reads the record through the ordinary verb path, so it wakes
       the database once a day — negligible against the 100 CU-h/month Neon free
       tier that governs rules-refresh's schedule. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>{{REPO}}/out/preflight-watch.out</string>
  <key>StandardErrorPath</key><string>{{REPO}}/out/preflight-watch.out</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/opt/node@22/bin:/opt/homebrew/opt/libpq/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
