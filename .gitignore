.DS_Store
__pycache__/
*.pyc
.venv/
out/
# ...and the bare name, because in a WORKTREE `out` is a SYMLINK to the
# canonical out/, and a trailing-slash pattern matches directories only —
# so the link itself showed up as untracked in every worktree (2026-08-10).
out
mcp-server/.neon
_to_delete/
*.bak-*

# PII never lives in this repo (Joe ruling (a), 2026-08-01; ORDER 42)
frozen-sources/
exporters/templates/

# PII output baselines — full HTML stays local, only sha256 tracked (ORDER 42b, 2026-08-06)
# See baselines/SHA256SUMS. Regenerate locally: tools/check.sh --out <name> tells you how.
baselines/lead-board.html
baselines/deal-room-panhandle.html

# Encrypted DB dumps — archived to R2 instead of git (ORDER 42b, 2026-08-06). See bin/backup-dump.sh.
backups/*.sql.age

# Swift build artifacts — regenerated by bin/build-dictate.sh, never source
tools/dictation-rig/dictate/.build/

# Python virtualenvs — never source, and they carry >100MB binaries GitHub refuses
.venv/
.venv-*/
**/.venv-*/

# A bare .venv is usually a symlink into the primary checkout; the trailing-slash
# patterns above match directories only, so name it explicitly too.
.venv

# Claude Code worktrees — each is a live CHECKOUT of this repo (it carries its
# own .git file), not content of it. Untracked, they sat one `git add .` away
# from a nested-checkout commit, which is the sweep rule 308ef1de exists to
# stop. Added 2026-08-11 after two appeared during a live two-writer session.
.claude/worktrees/

# doc-convo run artifacts — a server log and a session id, regenerated on every
# run. The harvest-* corpus files beside them are deliberately NOT listed: that
# lane owns the call on whether they are source or output.
tools/doc-convo/assets/whisper-server.log
tools/doc-convo/assets/.harvest-brain-session-id

# Client deal material never enters this repo, private or not (Joe ruling (a),
# 2026-08-01, ORDER 42 — the same rule that keeps frozen-sources/ out). Packet
# generators embed the client's name and advisory prose addressed to them, the
# branded PDFs are the client's own documents, and the tmp-*-review folders are
# page renders of those documents. Finished client deliverables live in the
# Drive vault under Output/; scratch renders are staged in the vault _to_delete/.
# The patterns are deliberately generic: naming a client here would put the very
# identifier this rule exists to keep out into a tracked file.
build_*_carr_pdfs.py
tmp-*-review/
deliverables/*-carr-branded-*/

# graphify code graph — regenerated by `graphify update ~/carr-system`, 17M of
# derived output. The GRAPH is not source; the command that rebuilds it is.
graphify-out/

# ops/ci-selftest.py's crash-recovery journal. Present only while a seeded
# defect is live in the tree, or after a run was killed before restoring it —
# the next run reads this, repairs every path it names, and refuses to start.
# Ignored rather than tracked because it holds the ORIGINAL BYTES of whatever it
# seeded, so a whole-tree staging command would commit the contents of arbitrary
# files. Recovery does not depend on it being visible to git: the selftest reads
# it directly.
_ci_selftest_seed_journal.json

# CARR Calendar Access.app: per-machine build artifacts (bin/build-calendar-access.sh).
# The ad-hoc signature verifies only on the Mac that made it and the compiled stub
# is arch-specific, so both are rebuilt locally rather than shipped in git.
tools/CARR Calendar Access.app/Contents/_CodeSignature/
tools/CARR Calendar Access.app/Contents/MacOS/carr-calendar-access
