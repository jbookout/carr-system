<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- doctrine: repo-hygiene-program-build-plan — WR-000040 AC-FRESH -->
  <!-- DEFINITION ONLY. This agent is deliberately not installed and not loaded.
       It is listed in DEFINITION_ONLY in ops/config-as-code.py, so `install`
       skips it by name and `check` accepts its absence from the machine as the
       intended state while refusing any copy that turns up in LaunchAgents.

       WHY THE DEFINITION EXISTS AT ALL, given that nothing runs it: a job that
       moves the canonical checkout's branch is exactly the shape that should be
       reviewed as source before it is reviewed as a running job. Writing the
       cadence, the arguments and the log path down now, inert, is what lets a
       later reviewer read them rather than being handed them at activation
       time. Activation is Joe's separate ruling and is not granted here. -->
  <key>Label</key><string>com.carr.canonical-fast-forward</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/run-scheduled.sh</string>
    <string>canonical-fast-forward</string>
    <string>launchd.run</string>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/canonical-fast-forward.sh</string>
    <string>--repository</string>
    <string>{{REPO}}</string>
  </array>
  <key>WorkingDirectory</key><string>{{REPO}}</string>
  <!-- NO CADENCE AND NO TRIGGER. RunAtLoad is false and there is deliberately
       no StartCalendarInterval, no StartInterval and no WatchPaths, so this
       agent has no moment at which it would fire. The cadence AC-FRESH implies
       — at least daily, so canonical stays within one day of origin/main — is
       written in the activation ruling, not smuggled in here where a single
       `launchctl load` would start it. -->
  <key>RunAtLoad</key><false/>
  <!-- A log path from the first line: launchd discards output when neither path
       is set, and a fast-forward that quietly never ran looks exactly like one
       that ran and found nothing to do. Both streams share one file so a reader
       can see which output preceded a failure. -->
  <key>StandardOutPath</key><string>{{REPO}}/out/canonical-fast-forward.log</string>
  <key>StandardErrorPath</key><string>{{REPO}}/out/canonical-fast-forward.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/opt/node@22/bin:/opt/homebrew/opt/libpq/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
