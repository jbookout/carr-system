<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Apple Notes call-recording intake. This intentionally REPLACES the
    `notes-sweep-hourly` Claude scheduled task: scanning Notes is a local,
    idempotent transport job, not a conversation. Keeping it in launchd means
    quiet no-op scans do not create agent sessions or occupy a sessions panel.

    `notes-sweep-post.sh --scheduled` owns the weekday 08:00–18:59 local gate;
    this agent simply wakes hourly. The gate lives in the shared script so a
    manual run and an unattended run still execute one implementation.

    Apple Notes is a local macOS application. This is a LaunchAgent, not a
    daemon: it runs only after Joe has logged in. `RunAtLoad` lets it catch up
    promptly after login; the ingest socket's external-id uniqueness makes a
    repeat safe. The actual work and its durable log remain in
    `bin/notes-sweep-post.sh` and `out/capture-lanes.log`.
  -->
  <key>Label</key><string>com.carr.notes-sweep</string>

  <!-- Program 4: routed through bin/with-run-record.sh so this job's own
       success/failure becomes a durable ops.run row. No throttle — hourly is
       already low-volume. -->
  <key>ProgramArguments</key>
  <array>
    <string>{{REPO}}/bin/with-run-record.sh</string>
    <string>notes-sweep</string>
    <string>--</string>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/notes-sweep-post.sh</string>
    <string>--scheduled</string>
  </array>

  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key><string>{{REPO}}/out/notes-sweep-launchd.log</string>
  <key>StandardErrorPath</key><string>{{REPO}}/out/notes-sweep-launchd.log</string>
</dict>
</plist>
