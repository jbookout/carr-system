<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- doctrine: repo-hygiene-program-build-plan — WR-000040 AC-FRESH -->
  <!-- DEFINITION ONLY, exactly as its sibling above. Listed in DEFINITION_ONLY
       in ops/config-as-code.py; `install` skips it and `check` refuses any copy
       found in LaunchAgents.

       THIS IS A SEPARATE AGENT ON PURPOSE, and the separation is the whole
       design. com.carr.canonical-fast-forward cannot page about its own
       absence: launchd drops an agent whose plist is unloaded or whose program
       is missing and says nothing. This watchdog reads the REPOSITORY, never
       the job, so it still alarms if the fast-forward agent is deleted. Two
       plists is the cost of that property, and one plist with two invocations
       would not hold it. -->
  <key>Label</key><string>com.carr.canonical-dirty-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/run-scheduled.sh</string>
    <string>canonical-dirty-watchdog</string>
    <string>launchd.run</string>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/canonical-dirty-watchdog.sh</string>
    <string>--repository</string>
    <string>{{REPO}}</string>
    <string>--max-age-hours</string>
    <string>24</string>
  </array>
  <key>WorkingDirectory</key><string>{{REPO}}</string>
  <!-- NO CADENCE AND NO TRIGGER, for the same reason as its sibling. A watchdog
       that fires on the same schedule as the job it watches would also have to
       be activated in the same ruling; both cadences belong to that ruling. -->
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>{{REPO}}/out/canonical-dirty-watchdog.log</string>
  <key>StandardErrorPath</key><string>{{REPO}}/out/canonical-dirty-watchdog.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/opt/node@22/bin:/opt/homebrew/opt/libpq/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
