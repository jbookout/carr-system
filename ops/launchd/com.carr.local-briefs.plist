<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.carr.local-briefs</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/local-briefs.sh</string>
  </array>
  <!-- Weekdays at 06:45 local, ahead of the morning heartbeat so it reads fresh
       outputs rather than yesterday's. Weekday-only matches the standing
       weekend stand-down (Joe, 2026-07-11): Sat/Sun are not workdays and Monday
       absorbs the backlog. Weekday keys are 1=Mon through 5=Fri.

       WHY LOCAL AND NOT A SECOND HEARTBEAT (loop #181): the heartbeat itself is
       scheduled in Cowork and fires every morning, but brief-pack and
       review-queue had not rebuilt since 2026-08-02 — the trigger runs, these
       two jobs do not. Leading hypothesis, UNTESTED: a Cowork session cannot
       reach ~/carr-system so it cannot run repo commands. This job covers only
       the repo-bound half and asserts nothing about the cause. Retire it if the
       Cowork side is later proven able to run them. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/opt/node@22/bin:/opt/homebrew/opt/libpq/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
