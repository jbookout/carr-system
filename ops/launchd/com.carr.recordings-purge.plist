<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Recordings retention law (decision db7b0231): raw audio purges 72h
         after transcription; transcript + consent proof survive. Daily at
         04:15 local; RunAtLoad catches the case where the Mac was asleep. -->
    <key>Label</key>
    <string>com.carr.recordings-purge</string>
    <!-- Program 4: routed through bin/with-run-record.sh so this job's own
         success/failure becomes a durable ops.run row. No throttle — daily is
         already low-volume. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{REPO}}/bin/with-run-record.sh</string>
        <string>recordings-purge</string>
        <string>--</string>
        <string>/bin/sh</string>
        <string>{{REPO}}/tools/dictation-rig/bin/purge-recordings.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
