<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- doctrine: tailscale-start-at-login -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.carr.tailscale-up</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/tailscale-up.sh</string>
  </array>

  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>120</integer>

  <key>StandardOutPath</key><string>{{REPO}}/out/tailscale-up.log</string>
  <key>StandardErrorPath</key><string>{{REPO}}/out/tailscale-up.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
