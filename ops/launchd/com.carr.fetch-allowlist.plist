<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.carr.fetch-allowlist</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/run-scheduled.sh</string>
    <string>fetch-allowlist</string>
    <string>launchd.run</string>
    <string>{{REPO}}/.venv/bin/python</string>
    <string>{{REPO}}/ops/fetch-allowlist.py</string>
  </array>
  <key>WorkingDirectory</key><string>{{REPO}}</string>
  <!-- SECONDARY MACHINE ONLY. The record-derived host allowlist is machine-local
       and gitignored, so every machine has to generate its own or its egress
       guard silently falls back to the code list and client practice sites stop
       resolving. On the primary machine bin/nightly.sh already does this as one
       of its steps; this job exists so the second machine gets the refresh
       WITHOUT inheriting the rest of the nightly chain, which writes shared
       state (see PRIMARY_ONLY in ops/config-as-code.py).

       Once daily, not hourly. It wakes the database, and the Neon free tier is
       100 CU-h/month at roughly 5 minutes per wake — the same cost ruling that
       keeps rules-refresh on business hours. Daily costs ~2.5 CU-h/month; the
       list only changes when a client or lead is added, so hourly would buy
       nothing. 07:05 so it lands before the workday rather than at the same
       minute as every other 7am job. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>5</integer></dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/opt/node@22/bin:/opt/homebrew/opt/libpq/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
