  "schema_version": 1,
  "source_of_truth": "The active rule store renders; these arrays are an exact, versioned coverage inventory, not a second rule source.",
  "default_category": "judgment_advisory",
  "categories": {
    "hard_pre_action": {
      "meaning": "An external control refuses the named operation before it runs.",
      "implementation": ["Claude/Codex PreToolUse hooks", "server-side actor/profile checks"],
      "test": ["ops/guard-selftest.py", "ops/delegation-gate-selftest.py", "ops/conduct-gate-selftest.py"],
      "friction": "Only the risky action is stopped."
    },
    "transactional_schema": {
      "meaning": "The record layer rejects invalid state, stale writes, or unauthorized mutations.",
      "implementation": ["mcp-server/src/tools.js versionGuard", "database constraints and grants"],
      "test": ["mcp-server/test/*.test.js", "migration probes"],
      "friction": "Only an invalid or concurrent write is refused."
    },
    "post_action_verification": {
      "meaning": "A changed build or record requires evidence before it may be claimed complete.",
      "implementation": ["Stop hooks", "health and independent verification checks"],
      "test": ["ops/completion-evidence-gate-selftest.py"],
      "friction": "Applies only after a mutation, deploy, or multi-file build."
    },
    "session_task_rail": {
      "meaning": "A task-start or phase-boundary rail supplies state, routing, or reminders; it is not a universal operation denial.",
      "implementation": ["session-brief.py", "delegation-gate.py", "context-handoff-gate.py"],
      "test": ["ops/delegation-gate-selftest.py"],
      "friction": "No prompt-time ceremony for ordinary work."
    },
    "judgment_advisory": {
      "meaning": "Requires contextual human-quality judgment and is reviewed through task-specific checks rather than brittle keyword refusal.",
      "implementation": ["standing-context", "task-specific review", "sampled independent verification"],
      "test": ["task-level evidence"],
      "friction": "No automatic interruption."
    }
  },
