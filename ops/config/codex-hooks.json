{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/guard-unattended.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*__teach",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/rule-shape-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/record-home-gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/ledger-sweep.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
