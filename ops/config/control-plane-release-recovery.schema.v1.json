{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CARR Control Plane release recovery procedure",
  "type": "object",
  "required": ["schema_version", "contract", "candidate", "database_down_migration", "applied_schema_mutation", "previous_worker_traffic_rollback", "provider_version_recovery_path", "existing_version_promotion", "separate_promotion_requirement", "existing_promotion_contract_paths", "forward_fix_steps"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "contract": {"const": "control-plane-release-recovery-procedure"},
    "candidate": {
      "type": "object", "required": ["migrations"], "additionalProperties": false,
      "properties": {"migrations": {"type": "array", "const": ["0193_session_work", "0194_atomic_rule_approval", "0195_control_plane_cache_observations", "0199_guidance_standing_context_boundary", "0212_doctrine_meta_singleton", "0215_program5_completion_hash_grant", "0223_doctrine_search_reads_without_writing_or_reading_actor", "0225_ops_run_fixture_row_guard", "0226_calendar_canary_record_layer", "0227_nightly_availability_canary_record_layer", "0228_atomic_rule_lifecycle_forward_upgrade", "0229_calendar_prebrief_projection", "0230_renewal_decision_delivery", "0249_calendar_prebrief_joe_runtime", "0250_renewal_signed_source_ingress"]}}
    },
    "database_down_migration": {"const": "does_not_exist"},
    "applied_schema_mutation": {"const": "never_by_this_procedure"},
    "previous_worker_traffic_rollback": {"const": "not_authorized_by_this_plan"},
    "provider_version_recovery_path": {"const": "fresh_upload_only"},
    "existing_version_promotion": {"const": "forbidden_by_this_plan"},
    "separate_promotion_requirement": {
      "type": "object", "required": ["required_inputs"], "additionalProperties": false,
      "properties": {"required_inputs": {"type": "array", "const": ["fresh_source_sha", "fresh_uploaded_provider_version", "new_release_id", "new_plan_hash", "post_deploy_live_readback"]}}
    },
    "existing_promotion_contract_paths": {"type": "array", "const": ["migrations/0172_program5_release_assurance.sql", "tools/release-manifest.py", "tools/ops-record.py", "bin/deploy-worker.sh", "ops/verify-worker-release.py", "bin/migrate-prod.sh"]},
    "forward_fix_steps": {"type": "array", "const": [{"id": "contain", "action_kind": "contain"}, {"id": "repair", "action_kind": "repair"}, {"id": "verify", "action_kind": "verify"}]}
  },
  "additionalProperties": false
}
