        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/write-effect-check.py",
          "timeout": 15
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/map-architecture-gate.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/conduct-stop-gate.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/completion-evidence-gate.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/ledger-sweep.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/context-handoff-gate.py",
          "timeout": 20
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/scheduled-run-record.py",
          "timeout": 20
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/chat-lint-gate.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/stale-claim-gate.py",
          "timeout": 20
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/loose-work-gate.py"
        },
        {
          "type": "command",
          "command": "/usr/bin/python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/run-record-gate.py drift-assertion-gate.py",
          "timeout": 20
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/unread-artifact-gate.py",
          "timeout": 20
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/rule-pack-drift-gate.py",
          "timeout": 20
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/gate-integrity.py",
          "timeout": 15
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/chat-lint-carryover.py"
        }
      ]
    }
