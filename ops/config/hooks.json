{
  "PreToolUse": [
    {
      "matcher": "Bash|WebFetch",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/guard-unattended.py",
          "timeout": 15
        }
      ]
    },
    {
      "matcher": "mcp__.*__teach",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/rule-shape-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Write|Edit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/record-home-gate.py",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/gate-edit-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "AskUserQuestion",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/escalation-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/git-writer-gate.py",
          "timeout": 20
        }
      ]
    },
    {
      "matcher": "Agent",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/executor-tier-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Bash|mcp__claude-in-chrome__.*",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/model-floor-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "mcp__.*__(record-defect|add-loop)",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/drift-claim-gate.py",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Write|Edit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/lint-gate.py",
          "timeout": 40
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/conduct-stop-gate.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/completion-evidence-gate.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/ledger-sweep.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/context-handoff-gate.py",
          "timeout": 20
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/gate-integrity.py",
          "timeout": 15
        }
      ]
    }
  ]
}
