{
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/rule-pack-preuse-reselection.py",
          "timeout": 20
        }
      ]
    },
    {
      "matcher": "Bash|WebFetch",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/guard-unattended.py",
          "timeout": 15
        }
      ]
    },
    {
      "matcher": "mcp__.*__(teach|activate-rule)",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/rule-shape-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Write|Edit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/record-home-gate.py",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/gate-edit-gate.py",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/canonical-edit-gate.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/close-before-open-gate.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/one-repo-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "AskUserQuestion",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/escalation-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/git-writer-gate.py",
          "timeout": 20
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/staging-attribution-gate.py",
          "timeout": 20
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/staging-observation-tracker.py",
          "timeout": 20
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/settings-change-gate.py"
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/bash-write-gate.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/write-effect-check.py",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/draft-export-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Agent",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/executor-tier-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Bash|mcp__claude-in-chrome__.*",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/model-floor-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "mcp__claude-in-chrome__.*",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/costar-lane-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "mcp__.*__(record-defect|add-loop)",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/run-record-gate.py drift-claim-gate.py",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/escalation-gate.py",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/blocker-decider-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "PushNotification|mcp__.*__(send_message|create_draft|update_draft)",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/weekend-quiet-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "SendMessage",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/peer-broadcast-gate.py"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Write|Edit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/lint-gate.py",
          "timeout": 40
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/staging-observation-tracker.py",
          "timeout": 20
        },
        {
          "type": "command",
          "command": "/usr/bin/env python3 {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/settings-change-gate.py"
