#!/bin/sh
# commit-msg — the commit message and the diff must agree (rule 24e10ee8).
#
# WHY THIS EXISTS. On 2026-08-13 a commit message claimed the gate baseline had
# been re-blessed; its diff contained no baseline. The message is the one part
# of a commit that nothing else verifies — CI runs the tree, the baseline
# hashes the gates, the message can say anything. This hook checks the two
# claim shapes that have actually lied here against the staged diff; the logic
# and its rationale live in commit-claims-check.py beside this file.
#
# WHAT THIS IS AND IS NOT, in the same terms as its neighbours: an
# accident-stopper, not a security control. Bypass is --no-verify or the
# escape hatch below; both are visible choices where silence was not.
#
#   CARR_ALLOW_CLAIM_MISMATCH=1 git commit ...
#
# Guarded on python3 and the helper being present, because an accident-stopper
# whose interpreter or file is missing must degrade to silence, not to
# blocking every commit on the machine.

hookdir="$(dirname "$0")"
if [ "$CARR_ALLOW_CLAIM_MISMATCH" != "1" ] \
    && [ -f "$hookdir/commit-claims-check.py" ] \
    && command -v python3 >/dev/null 2>&1; then
  python3 "$hookdir/commit-claims-check.py" "$1" || exit 1
fi
exit 0
