#!/bin/sh
# pre-push — refuse a direct push to main from anyone but the repo owner.
#
# WHY THIS EXISTS. On 2026-08-03 Dell was granted WRITE on carr-system,
# superseding the read-plus-fork-PR model in team-loops T39 where every change
# of his went through a pull request Joe approved. That review WAS the guard.
# GitHub branch protection would replace it, but this repo is private on a free
# plan and the API refuses: "Upgrade to GitHub Pro or make this repository
# public to enable this feature." So there is no server-side gate at all.
#
# The realistic failure is not malice, it is history. This repo's history was
# REWRITTEN on 2026-08-01 for the PII purge, which is why Dell re-clones from
# scratch rather than pulling. A session on a second machine that does not know
# that can force-push over the purge while doing something entirely reasonable.
#
# WHAT THIS IS AND IS NOT. It is an accident-stopper, not a security control.
# It is a local hook: anyone can bypass it by editing this file, unsetting
# core.hooksPath, or passing --no-verify. That is fine and expected — it exists
# to catch the push nobody meant to make, which is the only kind that has ever
# happened here. If real enforcement is wanted, GitHub Pro at roughly 4 USD a
# month enables branch protection and this file becomes redundant.
#
# HOW IT DECIDES, with no per-machine configuration to forget: the repo owner is
# identified by git identity. Joe's is set globally on his Mac and matches
# OWNER_EMAIL below. Any other identity pushing to main is stopped and told to
# branch instead. An explicit override exists for the case where the owner is on
# a machine whose identity is not yet configured.

OWNER_EMAIL="64207374+jbookout@users.noreply.github.com"
PROTECTED="refs/heads/main"

# Deliberate escape hatch. Set it for one command, never export it in a profile:
#   CARR_ALLOW_MAIN_PUSH=1 git push
if [ "$CARR_ALLOW_MAIN_PUSH" = "1" ]; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "$PROTECTED" ] || continue

  ME="$(git config user.email 2>/dev/null)"
  [ "$ME" = "$OWNER_EMAIL" ] && continue

  # A deletion or a non-fast-forward is the shape that destroys history.
  EXTRA=""
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    EXTRA="  This push DELETES the branch."
  elif [ -n "$remote_sha" ] && [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      EXTRA="  This push REWRITES history that is already on the remote — the shape that would undo the 2026-08-01 PII purge."
    fi
  fi

  cat >&2 <<EOF

  ────────────────────────────────────────────────────────────────
  PUSH TO main REFUSED — carr-system pre-push hook
  ────────────────────────────────────────────────────────────────
  Pushing as: ${ME:-(no git identity set)}
  Only the repo owner pushes straight to main.${EXTRA}

  Do this instead:

      git switch -c your-branch-name
      git push -u origin your-branch-name

  Then open a pull request. Joe reviews and merges. Nothing of yours
  is blocked by his side and nothing of his is overwritten by yours.

  If you are Joe and this machine has no git identity yet:

      git config --global user.email "$OWNER_EMAIL"

  Genuine one-off override, for this single command only:

      CARR_ALLOW_MAIN_PUSH=1 git push

  ────────────────────────────────────────────────────────────────

EOF
  exit 1
done

# ---------------------------------------------------------------------------
# PROGRAM 2 QUALITY GATE, added 2026-08-13.
#
# WHY IT IS HERE AND NOT ONLY IN CI. GitHub Actions runs the same checks on every
# push, but this repo is private on a free plan, so a red CI run cannot BLOCK
# anything — branch protection and rulesets both refuse with "Upgrade to GitHub
# Pro" (verified live against both endpoints). Until Pro is enabled, this hook is
# the only place a failing check actually stops something, so a red tree does not
# leave the machine.
#
# IT CALLS ops/ci.sh AND DEFINES NO CHECKS OF ITS OWN. Same script GitHub runs
# (rule a8c55a47). A check added there appears here for free and cannot exist in
# one path and not the other.
#
# NOT --strict, deliberately. On a laptop there is no throwaway Postgres, so the
# migration class SKIPs, and under --strict a skip is a failure. Failing every
# local push over a database that is only ever present in CI would teach everyone
# to pass --no-verify, which would disable the whole hook rather than one class.
# CI runs --strict; here a skip is reported and allowed.
#
# THE ESCAPE HATCH IS REAL AND STATED. --no-verify skips this, same as it skips
# the branch guard above. This is an accident-stopper, not a security control:
# anyone can edit this file or unset core.hooksPath. It exists to catch the push
# nobody meant to make, which is the only kind that has ever happened here.
# ---------------------------------------------------------------------------

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "$REPO_ROOT" ] && [ -x "$REPO_ROOT/ops/ci.sh" ]; then
  if [ "$CARR_SKIP_CI" = "1" ] 2>/dev/null; then
    echo "  pre-push: CARR_SKIP_CI=1 — quality checks skipped for this command" >&2
  else
    echo "  pre-push: running ops/ci.sh before this push leaves the machine…" >&2
    # STRIP THE HOOK'S GIT ENVIRONMENT BEFORE RUNNING CI, and this is not hygiene —
    # it is the fix for a bug that destroyed local main on 2026-08-14.
    #
    # Git exports GIT_DIR (and usually GIT_INDEX_FILE) to every hook. Those
    # variables OVERRIDE cwd for any child `git` process. CI runs selftests that
    # build throwaway repositories with tempfile.mkdtemp and then call git with
    # cwd set to that temp path — which is correct, sandboxed code, and which git
    # ignored entirely here, because GIT_DIR pointed at the live repository.
    #
    # So every one of those fixture commits landed on the LIVE checkout, on
    # whatever branch happened to be current. The damage, found by a peer session:
    # local main sitting on a commit whose tree held THREE files, six commits ahead
    # of origin, five of them selftest artifacts named "seed", "seed unrelated" and
    # one stamped with the fixture hash +deadbeef, with all 818 paths staged as
    # additions — so any commit from any session would have swept the whole repo
    # under one message. Origin was never touched; recovery was a mixed reset.
    #
    # ONE AMENDMENT from the loop #371 pass. Scrubbing here is the right FIRST
    # line of defence and it stays. But "the selftests were never wrong" does not
    # survive contact: a test that mutates whatever repository invoked it is
    # wrong on its own terms, whoever set the variable. This hook is only ONE way
    # ci.sh is reached — another git hook, a merge driver, `git rebase -x`, or a
    # session that simply has GIT_DIR exported all get to the same selftests
    # without passing through here. So the selftests scrub for themselves now
    # (ops/git_env.py) and this remains the outer layer.
    #
    # THE LIST STAYS LITERAL HERE ON PURPOSE. Sourcing it from
    # `python3 ops/git_env.py --unset-args` was tried and reverted: it defeats
    # ops/hook-env-isolation-selftest.py, which deliberately checks that the
    # stripping and the ci.sh call are ONE statically readable statement, and it
    # puts a python dependency on the push path whose fallback would go stale in
    # silence. A literal list that a test can read beats a clever one it cannot.
    # ops/git-env-selftest.py fails if this list stops covering
    # git_env.GIT_LOCATION_VARS, so the two cannot drift even though the words
    # appear twice.
    env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
        -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
        -u GIT_COMMON_DIR -u GIT_NAMESPACE -u GIT_CEILING_DIRECTORIES \
        -u GIT_WORK_TREE_OVERRIDE -u GIT_CONFIG -u GIT_CONFIG_GLOBAL \
        -u GIT_CONFIG_SYSTEM -u GIT_CONFIG_COUNT \
        sh -c 'exec "$0"' "$REPO_ROOT/ops/ci.sh"
    if [ $? -ne 0 ]; then
      cat >&2 <<'EOF'

  ────────────────────────────────────────────────────────────────
  PUSH REFUSED — carr-system quality checks failed
  ────────────────────────────────────────────────────────────────
  The failing class is named above. Run it on its own to iterate:

      ops/ci.sh --only <class>
      ops/ci.sh --list

  Fix it, or say out loud that you are pushing anyway:

      CARR_SKIP_CI=1 git push

  ────────────────────────────────────────────────────────────────

EOF
      exit 1
    fi
  fi
fi

exit 0
