{
  "schema": "carr-runtime-errors.v1",
  "version": "1.0.0",
  "browser_endpoint": "/api/v1/runtime-errors",
  "edge_entrypoint": "RuntimeErrorSink",
  "edge_method": "capture",
  "storage": "Cloudflare SQLite Durable Object",
  "types": ["Error", "TypeError", "ReferenceError", "SyntaxError", "RangeError", "URIError", "EvalError", "AggregateError", "HTTP5xx", "UnhandledRejection"],
  "route_segments": ["api", "v1", "auth", "mcp", "health", "healthz", "release", "app-release", "runtime-errors", "pipeline", "changes", "capture", "clients", "vendors", "deals", "leads", "tours", "status", "control-room", "business", "workspace", "incidents", "invoices", "notifications", "search", "room", "system-work"],
  "spike": { "count": 10, "window_ms": 300000, "update_at": "double the notified window count" },
  "auto_clear": { "quiet_ms": 86400000, "release": "different current source SHA with a Cloudflare version creation timestamp after the last error" },
  "privacy": "Allowlisted error types and message templates; all other values redacted; stack locations only; no request/response bodies or record fields."
}
