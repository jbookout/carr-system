{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${HOME}/carr-system/hooks/delegation-gate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${HOME}/carr-system/hooks/worktree-self-plumb.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${HOME}/carr-system/hooks/machine-converge.py\"",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git worktree:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git rm:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh run list:*)",
      "Bash(gh api repos/jbookout/carr-system/rulesets:*)",
      "Bash(gh api repos/jbookout/carr-system/branches/main/protection:*)",
      "mcp__b36e17b6-7e3b-4e65-b890-21f21d538440__read-loop",
      "mcp__b36e17b6-7e3b-4e65-b890-21f21d538440__search-doctrine",
      "mcp__b36e17b6-7e3b-4e65-b890-21f21d538440__loop-board",
      "mcp__b36e17b6-7e3b-4e65-b890-21f21d538440__standing-context",
      "mcp__b36e17b6-7e3b-4e65-b890-21f21d538440__read-doctrine",
      "mcp__b36e17b6-7e3b-4e65-b890-21f21d538440__list-verbs",
      "mcp__b36e17b6-7e3b-4e65-b890-21f21d538440__find",
      "mcp__b36e17b6-7e3b-4e65-b890-21f21d538440__read-room",
      "mcp__b36e17b6-7e3b-4e65-b890-21f21d538440__capability-program",
      "mcp__b36e17b6-7e3b-4e65-b890-21f21d538440__catch-me-up",
      "mcp__b36e17b6-7e3b-4e65-b890-21f21d538440__report-problem",
      "mcp__b36e17b6-7e3b-4e65-b890-21f21d538440__record-defect",
      "mcp__b36e17b6-7e3b-4e65-b890-21f21d538440__add-loop",
      "mcp__carr__report-problem",
      "mcp__carr__record-defect",
      "mcp__carr__add-loop",
      "mcp__claude_ai_CARR_Record_Layer__report-problem",
      "mcp__claude_ai_CARR_Record_Layer__record-defect",
      "mcp__claude_ai_CARR_Record_Layer__add-loop"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
