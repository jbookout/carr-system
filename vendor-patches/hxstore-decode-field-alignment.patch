 # Module-level email regex for UTF-16 string matching (text, not bytes).
 _TEXT_EMAIL_RE = re.compile(r"[\w.+-]+@[\w.]+\.\w{2,6}")
 
+# --- LOCAL PATCH (2026-08-03) ------------------------------------------------
+# Upstream assigns fields BY POSITION in the string sequence and never checks
+# that a value looks like what it is being assigned to. On a real mailbox that
+# puts MIME types ("image/png"), GUIDs and bare email addresses into `subject`,
+# and puts subjects into `sender_name`. These predicates let the extractor
+# REJECT a candidate rather than accept whatever sat at a given index.
+_MIME_RE = re.compile(r"^[a-z]+/[a-z0-9.+_-]+$", re.I)
+_GUID_RE = re.compile(
+    r"^\{?[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\}?$", re.I
+)
+_HEXID_RE = re.compile(r"^[0-9A-Fa-f]{16,}$")
+# Content-IDs appear both bare ("deadbeef@AAAA.BBBB") and with a filename
+# prefix ("image862976.png@67EC6C94.8A6BED82"). Both are attachment plumbing.
+_CONTENT_ID_RE = re.compile(r"^\S*@[0-9A-F]{6,}\.[0-9A-F]{6,}$", re.I)
+# Long unbroken base64 runs are tokens (Defender SafeLinks, tracking payloads),
+# never a human subject.
+_B64_BLOB_RE = re.compile(r"^[A-Za-z0-9+/=_-]{40,}$")
+
+
+def _is_msgid(s: str) -> bool:
+    return s.startswith("<") and "@" in s
+
+
+def _is_noise(s: str) -> bool:
+    """True when a string is structural metadata, never a human-facing field."""
+    if len(s.strip()) < 2:
+        return True
+    if _MIME_RE.match(s) or _GUID_RE.match(s) or _HEXID_RE.match(s):
+        return True
+    if _CONTENT_ID_RE.match(s) or _is_msgid(s):
+        return True
+    if " " not in s and _B64_BLOB_RE.match(s):
+        return True
+    if s in {"IPM.Note", "Standard", "Normal", "SMTP", "EX", "text/html", "UTF-8"}:
+        return True
+    return False
+
+
+def _undouble(s: str) -> str:
+    """Collapse a string that is exactly itself twice.
+
+    HxStore stores some display names doubled ("Wayne 'Dell' McCraneyWayne
+    'Dell' McCraney"), which upstream passes through verbatim.
+    """
+    n = len(s)
+    if n >= 6 and n % 2 == 0 and s[: n // 2] == s[n // 2:]:
+        return s[: n // 2]
+    return s
+
+
+def _is_name_like(s: str) -> bool:
+    """A display name: short, no address syntax, not a sentence."""
+    if _is_noise(s) or "@" in s or "/" in s:
+        return False
+    return 2 <= len(s) <= 60
+
+
+def _looks_like_person(s: str) -> bool:
+    """Title-cased, 1-5 words, no sentence punctuation. "Wayne 'Dell' McCraney"."""
+    if not s or "@" in s or _is_noise(s) or len(s) > 45:
+        return False
+    words = s.split()
+    if not 1 <= len(words) <= 5:
+        return False
+    if any(ch in s for ch in ".:!?;") and not s.endswith("."):
+        return False
+    capped = sum(1 for w in words if w[:1].isupper() or w[:1] in "'\"")
+    return capped >= max(1, len(words) - 1)
+
+
+def _looks_like_subject(s: str) -> bool:
+    """Long, or carrying the punctuation/prefixes that mark a subject line."""
+    if not s or _is_noise(s):
+        return False
+    if s[:3].upper() in ("RE:", "FW:") or s[:4].upper() == "FWD:":
+        return True
+    return len(s) > 45 or len(s.split()) > 5 or " - " in s
+
 
