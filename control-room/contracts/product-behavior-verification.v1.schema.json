{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "carr-control-room-product-behavior-verification-v1",
  "contract": "carr-control-room-product-behavior-verification",
  "version": "1.0.0",
  "status": "phase0_contract_foundation_not_deployed",
  "$comment": "Outside-in verification record for a deterministic CARR projection. It is evidence about a surface, never a Work Request store, an authority source, or a model-generated source of truth. A verified item requires live browser evidence.",
  "title": "CARR Product Behavior Verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "surface", "binding", "state_chart", "claims", "items", "findings", "audit_state"],
  "properties": {
    "schema_version": {"const": "product-behavior-verification.v1"},
    "surface": {"type": "object", "additionalProperties": false, "required": ["surface_id", "surface_version", "commit_ref"], "properties": {"surface_id": {"type": "string", "minLength": 1}, "surface_version": {"type": "string", "minLength": 1}, "commit_ref": {"type": "string", "minLength": 1}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["work_request_id", "projection_digest", "execution_evidence_refs"], "properties": {"work_request_id": {"type": "string", "minLength": 1}, "projection_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "execution_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "state_chart": {"type": "object", "additionalProperties": false, "required": ["starting_state", "immediate_ending", "becoming_extended", "while_extended", "finishing", "modifiers_variants", "cancel_interrupt", "cross_system_effects", "edge_cases", "open_verification"], "properties": {"starting_state": {"type": "array", "items": {"type": "string", "minLength": 1}}, "immediate_ending": {"type": "array", "items": {"type": "string", "minLength": 1}}, "becoming_extended": {"type": "array", "items": {"type": "string", "minLength": 1}}, "while_extended": {"type": "array", "items": {"type": "string", "minLength": 1}}, "finishing": {"type": "array", "items": {"type": "string", "minLength": 1}}, "modifiers_variants": {"type": "array", "items": {"type": "string", "minLength": 1}}, "cancel_interrupt": {"type": "array", "items": {"type": "string", "minLength": 1}}, "cross_system_effects": {"type": "array", "items": {"type": "string", "minLength": 1}}, "edge_cases": {"type": "array", "items": {"type": "string", "minLength": 1}}, "open_verification": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "claims": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "state_ref", "priority", "observable_claim"], "properties": {"claim_id": {"type": "string", "minLength": 1}, "state_ref": {"type": "string", "minLength": 1}, "priority": {"enum": ["P0", "P1", "P2", "P3"]}, "observable_claim": {"type": "string", "minLength": 1}}}},
    "items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["item_id", "claim_id", "priority", "setup", "steps", "expected", "status", "evidence_refs"], "properties": {"item_id": {"type": "string", "minLength": 1}, "claim_id": {"type": "string", "minLength": 1}, "priority": {"enum": ["P0", "P1", "P2", "P3"]}, "setup": {"type": "string", "minLength": 1}, "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "expected": {"type": "string", "minLength": 1}, "status": {"enum": ["planned", "passed", "failed", "blocked"]}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["finding_id", "root_cause_key", "actual", "expected", "repro", "code_location", "severity", "decision", "post_fix_status", "evidence_refs"], "properties": {"finding_id": {"type": "string", "minLength": 1}, "root_cause_key": {"type": "string", "minLength": 1}, "actual": {"type": "string", "minLength": 1}, "expected": {"type": "string", "minLength": 1}, "repro": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "code_location": {"type": "string", "minLength": 1}, "severity": {"enum": ["P0", "P1", "P2", "P3"]}, "decision": {"enum": ["fix", "product_call", "accepted"]}, "post_fix_status": {"enum": ["open", "fixed_pending_live_verification", "verified_fixed", "blocked"]}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    "audit_state": {"enum": ["draft", "live_verified", "blocked"]}
  }
}
