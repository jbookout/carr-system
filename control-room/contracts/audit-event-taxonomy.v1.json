{
  "contract": "carr-control-room-audit-event-taxonomy",
  "version": "1.0.0",
  "status": "phase0_frozen",
  "append_only": true,
  "required_fields": ["event_id", "event_type", "occurred_at", "correlation_id", "causation_id", "organization_tenant_id", "agent_principal_id", "runtime_principal", "sponsoring_human_id", "partner_id", "personal_brain_scope", "personal_brain_version", "personal_rule_count", "session_capability_profile", "service_id", "resource_id", "environment", "risk_class", "result", "failure_class", "redaction_class", "evidence_refs"],
  "conditional_fields": ["work_request_id", "agent_session_id", "plan_id", "plan_revision", "plan_hash", "approval_id", "release_id", "deployment_id", "incident_id", "before_hash", "after_hash", "idempotency_key"],
  "families": {
    "authentication_access": ["auth.succeeded", "auth.failed", "auth.audience_refused", "reauth.completed", "identity.runtime_validated", "identity.sponsor_resolved", "identity.unsponsored_task_scoped", "identity.scope_unknown", "identity.personal_scope_refused", "identity.source_mismatch", "identity.context_bound", "authorization.allowed", "authorization.refused", "capability.proposed", "capability.approved", "capability.expired_revoked", "read_only_kill_switch.changed"],
    "observation": ["collector.started", "collector.completed", "collector.failed", "freshness.became_stale", "health.changed", "check.completed", "job.completed", "edge_node.state_changed", "edge_node.permission_denied", "edge_node.power_recovery_verified", "edge_node.backup_restore_verified", "redaction.applied"],
    "work_session": ["request.captured", "request.deduplicated", "request.state_changed", "session.created", "session.scope_refused", "session.phase_changed", "session.blocked", "session.handed_off", "session.completed"],
    "plan_approval": ["plan.revision_created", "plan.rehearsed", "plan.hash_frozen", "approval.proposed", "approval.approved", "approval.not_required", "approval.rejected", "approval.expired", "approval.invalidated"],
    "release_deployment": ["release.assembled", "deployment.preflight_passed", "deployment.rehearsal_completed", "deployment.execution_started", "actuator.invoked", "deployment.reconnect_replayed", "deployment.verification_completed", "deployment.aborted", "deployment.rolled_back"],
    "incident_recovery": ["incident.detected", "incident.deduplicated", "incident.fact_recorded", "incident.hypothesis_recorded", "incident.mitigation_proposed", "incident.resolved", "incident.reviewed", "recovery.rehearsed"],
    "governance": ["feature_flag.evaluated", "feature_flag.changed", "schema.checksum_verified", "audit.exported", "retention.applied", "unsupported_action.refused", "state_transition.refused", "tenant.scope_refused", "tenant.configuration_refused", "workflow.pilot_started", "workflow.pilot_expired", "workflow.promotion_decided", "workflow.retired", "maintenance.time_recorded", "maintenance.toil_triggered", "maintenance.remedy_opened", "alert.deduplicated", "automation.outcome_verified", "automation.refused"]
  },
  "chain": ["origin", "agent_session", "plan_revision", "approval", "execution", "verification", "release_or_incident"],
  "identity_attribution": {
    "actor_rule": "agent_principal_id and runtime_principal identify the executor; sponsoring_human_id and partner_id identify verified human provenance without overwriting the actor",
    "scope_rule": "organization tenant, sponsor, agent, runtime, personal-brain scope/version/count, capability profile, and result are recorded for identity-bound actions",
    "zero_rule": "personal_rule_count zero is recordable only with an explicitly resolved personal_brain_scope and source parity; missing scope records identity.scope_unknown with a null count"
  },
  "never_record": ["secret values", "DSNs", "bearer tokens", "cookies", "authorization headers", "raw OAuth claims", "raw client payloads", "raw transcripts", "personal rule bodies", "personal human quotes", "unrestricted tool inputs or outputs", "prompt injection source text as instruction"]
}
