{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "carr-engineering-passport-v1",
  "contract": "carr-engineering-passport",
  "version": "1.0.0",
  "status": "phase0_contract_foundation_not_deployed",
  "title": "CARR Engineering Passport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_request",
    "accepted_plan_revision",
    "plan_digest",
    "slice_plan",
    "slices",
    "receipts",
    "reviewer_facts",
    "qa_facts",
    "operator_receipt",
    "closure",
    "closure_state",
    "stale_conflict",
    "projection_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "engineering-passport.v1"
    },
    "work_request": {
      "$ref": "#/$defs/Binding"
    },
    "accepted_plan_revision": {
      "$ref": "#/$defs/PlanRevision"
    },
    "plan_digest": {
      "$ref": "#/$defs/Digest"
    },
    "slice_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "work_request",
        "accepted_plan_revision",
        "plan_digest",
        "slices"
      ],
      "properties": {
        "schema_version": {
          "const": "engineering-slice-plan.v1"
        },
        "work_request": {
          "$ref": "#/$defs/Binding"
        },
        "accepted_plan_revision": {
          "$ref": "#/$defs/PlanRevision"
        },
        "plan_digest": {
          "$ref": "#/$defs/Digest"
        },
        "slices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SlicePlanItem"
          }
        }
      }
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/State"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "attempt_id",
          "slice_ref",
          "plan_digest",
          "outcome",
          "artifact_refs",
          "evidence_refs",
          "deviations",
          "attribution",
          "planned_resource_refs",
          "actual_resource_refs",
          "planned_component_refs",
          "actual_component_refs",
          "checks",
          "source_evidence",
          "reset_reconstruction",
          "executor_claim",
          "independent_verification_required",
          "envelope_digest"
        ],
        "properties": {
          "schema_version": {
            "const": "engineering-slice-receipt.v1"
          },
          "attempt_id": {
            "$ref": "#/$defs/Id"
          },
          "slice_ref": {
            "$ref": "#/$defs/Id"
          },
          "plan_digest": {
            "$ref": "#/$defs/Digest"
          },
          "outcome": {
            "enum": [
              "claimed_complete",
              "failed",
              "blocked",
              "reopened"
            ]
          },
          "artifact_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Id"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Evidence"
            }
          },
          "deviations": {
            "type": "array"
          },
          "attribution": {
            "type": "object"
          },
          "planned_resource_refs": {
            "type": "array"
          },
          "actual_resource_refs": {
            "type": "array"
          },
          "planned_component_refs": {
            "type": "array"
          },
          "actual_component_refs": {
            "type": "array"
          },
          "checks": {
            "type": "array",
            "minItems": 1
          },
          "source_evidence": {
            "type": "object"
          },
          "reset_reconstruction": {
            "type": "object"
          },
          "executor_claim": {
            "type": "object"
          },
          "independent_verification_required": {
            "const": true
          },
          "envelope_digest": {
            "$ref": "#/$defs/Digest"
          }
        }
      }
    },
    "reviewer_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReviewerFact"
      }
    },
    "qa_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/QAFact"
      }
    },
    "operator_receipt": {
      "$ref": "#/$defs/Operator"
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "proof",
        "explanation",
        "release",
        "learning"
      ],
      "properties": {
        "work": {
          "$ref": "#/$defs/Disposition"
        },
        "proof": {
          "$ref": "#/$defs/Disposition"
        },
        "explanation": {
          "$ref": "#/$defs/Disposition"
        },
        "release": {
          "$ref": "#/$defs/Disposition"
        },
        "learning": {
          "$ref": "#/$defs/LearningDisposition"
        }
      }
    },
    "closure_state": {
      "enum": [
        "blocked",
        "complete"
      ]
    },
    "stale_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason"
      ],
      "properties": {
        "state": {
          "enum": [
            "none",
            "stale",
            "conflict",
            "uncertain"
          ]
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "projection_digest": {
      "$ref": "#/$defs/Digest"
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state_version",
        "canonical_record_digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        },
        "canonical_record_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "PlanRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "redaction_class",
        "content_digest"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/Id"
        },
        "redaction_class": {
          "enum": [
            "metadata_only",
            "redacted_evidence"
          ]
        },
        "content_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evidence_refs",
        "note"
      ],
      "properties": {
        "state": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SlicePlanItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_ref",
        "ordinal",
        "objective",
        "definition_of_done",
        "dependency_refs",
        "declared_resource_refs",
        "declared_component_refs",
        "declared_plan_step_refs",
        "baseline_evidence_refs",
        "planned_checks",
        "scope_boundary",
        "forbidden_change_refs",
        "concurrency_posture",
        "manual_qa_required",
        "risk_class",
        "release_requirement"
      ],
      "properties": {
        "slice_ref": {
          "$ref": "#/$defs/Id"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "definition_of_done": {
          "type": "string",
          "minLength": 1
        },
        "dependency_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "declared_resource_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "declared_component_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "declared_plan_step_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "baseline_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "planned_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_ref",
              "failure_condition",
              "evidence_requirement"
            ],
            "properties": {
              "check_ref": {
                "$ref": "#/$defs/Id"
              },
              "failure_condition": {
                "type": "string",
                "minLength": 1
              },
              "evidence_requirement": {
                "enum": [
                  "redacted_evidence_required",
                  "metadata_only_sufficient"
                ]
              }
            }
          }
        },
        "scope_boundary": {
          "type": "string",
          "minLength": 1
        },
        "forbidden_change_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "concurrency_posture": {
          "enum": [
            "parallel_safe",
            "serial_after_dependencies",
            "exclusive_resource"
          ]
        },
        "manual_qa_required": {
          "type": "boolean"
        },
        "risk_class": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4",
            "R5",
            "R6"
          ]
        },
        "release_requirement": {
          "enum": [
            "required",
            "not_required"
          ]
        }
      }
    },
    "LearningDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "route",
        "evidence_refs",
        "note"
      ],
      "properties": {
        "state": {
          "enum": [
            "unresolved",
            "proposed",
            "rejected",
            "nothing_durable"
          ]
        },
        "route": {
          "enum": [
            "regression_test",
            "gate_or_validator",
            "decision_record",
            "skill_or_workflow",
            "memory_or_rule_candidate",
            "incident_finding",
            "speculative_finding",
            "nothing_durable"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "State": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_ref",
        "ordinal",
        "dependency_refs",
        "state",
        "planned_check_refs",
        "deviation_refs",
        "manual_qa_required",
        "release_requirement"
      ],
      "properties": {
        "slice_ref": {
          "$ref": "#/$defs/Id"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "dependency_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "state": {
          "enum": [
            "eligible",
            "blocked",
            "claimed",
            "reopened",
            "verified_complete"
          ]
        },
        "planned_check_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "deviation_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "manual_qa_required": {
          "type": "boolean"
        },
        "release_requirement": {
          "enum": [
            "required",
            "not_required"
          ]
        }
      }
    },
    "ReviewerFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_ref",
        "attempt_id",
        "reviewer_ref",
        "session_ref",
        "state",
        "evidence_refs",
        "is_independent",
        "reviewed_deviation_refs",
        "resolved_deviation_refs"
      ],
      "properties": {
        "slice_ref": {
          "$ref": "#/$defs/Id"
        },
        "attempt_id": {
          "$ref": "#/$defs/Id"
        },
        "reviewer_ref": {
          "$ref": "#/$defs/Id"
        },
        "session_ref": {
          "$ref": "#/$defs/Id"
        },
        "state": {
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "is_independent": {
          "const": true
        },
        "reviewed_deviation_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "resolved_deviation_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        }
      }
    },
    "QAFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_ref",
        "state",
        "evidence_refs",
        "note"
      ],
      "properties": {
        "slice_ref": {
          "$ref": "#/$defs/Id"
        },
        "state": {
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what_changed",
        "why",
        "evidence_refs",
        "deviations",
        "remaining_risk",
        "manual_qa_items"
      ],
      "properties": {
        "what_changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "deviations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "remaining_risk": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "manual_qa_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        }
      }
    }
  }
}
