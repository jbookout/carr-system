{
  "contract": "carr-control-room-authority-risk",
  "version": "1.0.0",
  "status": "phase0_frozen",
  "default_effect": "deny",
  "enforcement": {
    "permit_only_if": ["session audience is carr-control-room-web or the principal is a registered non-browser identity", "principal is active and mapped to a Control Room role", "capability is explicit, unexpired, and not revoked", "exact resource and environment are server allowed", "risk gate requirements pass", "global read-only kill switch permits mutation"],
    "never_authoritative": ["query parameter profile", "client supplied actor", "client supplied role", "client supplied environment", "client supplied risk class", "client supplied capability", "Workspace cookie", "Deal Room cookie", "MCP OAuth bearer", "AGENT_TOKENS", "PROBE_TOKENS", "REVIEW_TOKENS", "model prompt", "agent memory"]
  },
  "roles": {
    "joe_owner_production_approver": {"R0": "read authorized operations views", "R1": "own presentation preferences", "R2": "create and triage requests and evidence candidates", "R3": "confirm typed operating changes", "R4": "approve typed high-consequence record actions after re-authentication", "R5": "approve exact production plan hash after re-authentication; browser never executes", "R6": "review only; send in owning outbound system"},
    "dell_reporter_viewer": {"R0": "read safe health, requests, incidents, releases, and authorized audit summaries", "R1": "own presentation preferences", "R2": "create and refine requests and evidence candidates", "R3": "review or reject proposals only", "R4": "deny", "R5": "deny", "R6": "deny"},
    "doc_system_desk": {"R0": "scoped read and correlation", "R1": "deny", "R2": "create candidate requests, plans, and redacted evidence", "R3": "propose only", "R4": "deny", "R5": "deny", "R6": "draft only"},
    "codex_or_claude_code": {"R0": "read only within parent request scope", "R1": "deny", "R2": "attach structured evidence candidates", "R3": "propose and rehearse outside production", "R4": "deny", "R5": "repo work only; no Control Room approval or browser execution", "R6": "draft only"},
    "service_identity": {"R0": "submit registered collector observations", "R1": "deny", "R2": "submit idempotent evidence for one named job", "R3": "exact registered job only", "R4": "deny", "R5": "dedicated executor may invoke one registered actuator after broker validation", "R6": "deny"}
  },
  "dimensions": {
    "roles": ["joe_owner_production_approver", "dell_reporter_viewer", "doc_system_desk", "codex_or_claude_code", "service_identity"],
    "resources": ["overview", "services", "work_requests", "agent_sessions", "plans", "approvals", "releases", "deployments", "incidents", "audit_summaries", "audit_restricted", "collector_observations", "registered_actuators"],
    "environments": ["local", "rehearsal", "staging", "production"],
    "capabilities": ["read_ops_safe", "read_ops_restricted", "propose_request", "propose_plan", "submit_observation", "approve_plan_hash", "execute_registered_actuator", "draft_external_effect"]
  },
  "grants": [
    {"id": "G-P0-JOE-SAFE-READ", "phase": "phase0", "effect": "allow", "role": "joe_owner_production_approver", "risk_classes": ["R0"], "resources": ["overview", "services", "work_requests", "agent_sessions", "plans", "approvals", "releases", "deployments", "incidents", "audit_summaries"], "environments": ["local", "rehearsal", "staging", "production"], "capabilities": ["read_ops_safe"], "conditions": ["authenticated Control Room audience", "active principal", "server redaction"]},
    {"id": "G-P0-JOE-RESTRICTED-READ", "phase": "phase0", "effect": "allow", "role": "joe_owner_production_approver", "risk_classes": ["R0"], "resources": ["agent_sessions", "plans", "approvals", "audit_restricted"], "environments": ["local", "rehearsal", "staging", "production"], "capabilities": ["read_ops_restricted"], "conditions": ["authenticated Control Room audience", "recent authentication", "server redaction"]},
    {"id": "G-P0-DELL-SAFE-READ", "phase": "phase0", "effect": "allow", "role": "dell_reporter_viewer", "risk_classes": ["R0"], "resources": ["overview", "services", "work_requests", "releases", "deployments", "incidents", "audit_summaries"], "environments": ["local", "rehearsal", "staging", "production"], "capabilities": ["read_ops_safe"], "conditions": ["authenticated Control Room audience", "active principal", "server redaction"]},
    {"id": "G-P0-DOC-SCOPED-READ", "phase": "phase0", "effect": "allow", "role": "doc_system_desk", "risk_classes": ["R0"], "resources": ["overview", "services", "work_requests", "agent_sessions", "plans", "releases", "deployments", "incidents", "audit_summaries"], "environments": ["local", "rehearsal", "staging", "production"], "capabilities": ["read_ops_safe"], "conditions": ["registered non-browser identity", "exact parent request resource scope", "unexpired session"]},
    {"id": "G-P0-ENGINEERING-SCOPED-READ", "phase": "phase0", "effect": "allow", "role": "codex_or_claude_code", "risk_classes": ["R0"], "resources": ["services", "work_requests", "agent_sessions", "plans", "releases", "deployments", "incidents", "audit_summaries"], "environments": ["local", "rehearsal", "staging", "production"], "capabilities": ["read_ops_safe"], "conditions": ["registered non-browser identity", "exact parent request resource scope", "unexpired session"]},
    {"id": "G-P0-COLLECTOR-SUBMIT", "phase": "future_server_only", "effect": "allow", "role": "service_identity", "risk_classes": ["R0", "R2"], "resources": ["collector_observations"], "environments": ["local", "rehearsal", "staging", "production"], "capabilities": ["submit_observation"], "conditions": ["dedicated non-browser identity", "one registered collector", "schema valid", "idempotency key", "not exposed by Phase 0 read API"]}
  ],
  "explicit_denies": [
    {"id": "D-P0-MUTATION", "phase": "phase0", "roles": ["joe_owner_production_approver", "dell_reporter_viewer", "doc_system_desk", "codex_or_claude_code", "service_identity"], "resources": ["work_requests", "plans", "approvals", "releases", "deployments", "incidents", "registered_actuators"], "environments": ["local", "rehearsal", "staging", "production"], "capabilities": ["propose_request", "propose_plan", "approve_plan_hash", "execute_registered_actuator", "draft_external_effect"], "reason": "Phase 0 has no mutation, approval, grant, execution, or external-effect route."},
    {"id": "D-DELL-PRODUCTION", "phase": "all", "roles": ["dell_reporter_viewer"], "resources": ["approvals", "registered_actuators"], "environments": ["production"], "capabilities": ["approve_plan_hash", "execute_registered_actuator"], "reason": "Dell launches as Reporter/Viewer for system operations."},
    {"id": "D-AGENT-SELF-AUTHORITY", "phase": "all", "roles": ["doc_system_desk", "codex_or_claude_code", "service_identity"], "resources": ["approvals", "registered_actuators"], "environments": ["local", "rehearsal", "staging", "production"], "capabilities": ["approve_plan_hash"], "reason": "An agent or service identity cannot approve or grant itself authority."},
    {"id": "D-MOBILE-PRODUCTION", "phase": "initial_release", "roles": ["joe_owner_production_approver", "dell_reporter_viewer"], "resources": ["approvals", "registered_actuators"], "environments": ["production"], "capabilities": ["approve_plan_hash", "execute_registered_actuator"], "client_classes": ["phone", "tablet"], "reason": "No Production approval or execution on phone or iPad initially."}
  ],
  "risk_classes": {
    "R0": {"name": "Observe", "gate": "authenticated scoped read with declared redaction and freshness; no approval"},
    "R1": {"name": "Personal presentation", "gate": "own reversible preference only"},
    "R2": {"name": "Additive low-consequence", "gate": "exact target, schema validation, idempotency key, and audit; agents create candidates only"},
    "R3": {"name": "Material operating change", "gate": "fresh base version, old/new diff, human confirmation, event, and compensation path"},
    "R4": {"name": "High-consequence record change", "gate": "authorized human, recent re-authentication, typed target and provenance, second acknowledgement when irreversible or cross-owner"},
    "R5": {"name": "Control plane", "gate": "Joe approves immutable exact plan revision and hash after re-authentication; dedicated executor uses registered actuator after rehearsal and rollback readiness"},
    "R6": {"name": "External effect", "gate": "no Control Room execution route; Joe sends in the owning outbound system"}
  },
  "phase0": {
    "allowed_methods": ["GET", "HEAD", "OPTIONS"],
    "forbidden_routes": ["mutation", "approval decision", "capability grant", "actuator", "production execution", "break glass"],
    "production_mobile_approval": false
  }
}
