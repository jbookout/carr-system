{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "carr://control-room/contracts/carr-evaluation-kernel.v1.schema.json",
  "version": "1.0.0",
  "status": "phase1_contract_foundation_not_deployed",
  "title": "CARR Shared Evaluation Kernel v1",
  "description": "Offline, evidence-bound workflow evaluation and deterministic admission recommendation. It is not routing or promotion authority and deliberately defines no aggregate score.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "portfolio_id", "data_class", "generated_at", "workflow", "policy", "provenance", "outcome_horizon", "drift", "migration", "binding", "case_set", "taxonomy", "cases", "results", "frontier_comparisons", "experiments", "behavior_findings", "notes"],
  "properties": {
    "schema_version": {"const": "carr-evaluation-kernel.v1"},
    "portfolio_id": {"type": "string", "minLength": 1},
    "data_class": {"enum": ["synthetic_only", "metadata_only", "redacted_evidence"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "workflow": {"$ref": "#/$defs/workflow"},
    "policy": {"$ref": "#/$defs/policy"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "outcome_horizon": {"$ref": "#/$defs/outcome_horizon"},
    "drift": {"$ref": "#/$defs/drift"},
    "migration": {"$ref": "#/$defs/migration"},
    "binding": {"$ref": "#/$defs/binding"},
    "case_set": {"$ref": "#/$defs/case_set"},
    "taxonomy": {"$ref": "#/$defs/taxonomy"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}},
    "frontier_comparisons": {"type": "array", "items": {"$ref": "#/$defs/comparison"}},
    "experiments": {"type": "array", "items": {"$ref": "#/$defs/experiment"}},
    "behavior_findings": {"type": "array", "items": {"$ref": "#/$defs/behavior_finding"}},
    "notes": {"type": "string"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "workflow": {"type":"object","additionalProperties":false,"required":["workflow_id","rubric_id","rubric_version","rubric_digest","case_set_digest"],"properties":{"workflow_id":{"type":"string"},"rubric_id":{"type":"string"},"rubric_version":{"type":"string"},"rubric_digest":{"$ref":"#/$defs/digest"},"case_set_digest":{"$ref":"#/$defs/digest"}}},
    "policy": {"type":"object","additionalProperties":false,"required":["policy_id","policy_version","policy_digest","default_effect","risk_requirements"],"properties":{"policy_id":{"type":"string"},"policy_version":{"type":"string"},"policy_digest":{"$ref":"#/$defs/digest"},"default_effect":{"const":"deny"},"risk_requirements":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["risk_class","lifecycle","required_rungs","required_evaluator_kinds","min_held_out_cases","max_critical_failure_count","max_critical_failure_rate","confidence_posture","drift_tolerance","independent_review_required","human_acceptance_required","outcome_horizon_maturity"],"properties":{"risk_class":{"pattern":"^R[0-6]$"},"lifecycle":{"enum":["rehearsal","change","experiment","launch"]},"required_rungs":{"type":"array","items":{"enum":["smoke","regression","hill_climb","launch"]}},"required_evaluator_kinds":{"type":"array","items":{"enum":["deterministic","judge","human_acceptance"]}},"min_held_out_cases":{"type":"integer","minimum":0},"max_critical_failure_count":{"type":"integer","minimum":0},"max_critical_failure_rate":{"type":"number","minimum":0,"maximum":1},"confidence_posture":{"enum":["descriptive","lower_bound_required"]},"drift_tolerance":{"type":"number","minimum":0},"independent_review_required":{"type":"boolean"},"human_acceptance_required":{"type":"boolean"},"outcome_horizon_maturity":{"enum":["not_required","required"]}}}}}},
    "provenance": {"type":"object","additionalProperties":false,"required":["source_class","production_trace_review","expires_at"],"properties":{"source_class":{"enum":["synthetic_only","production_redacted"]},"production_trace_review":{"enum":["unavailable_no_production_traces","redacted_production_review"]},"expires_at":{"type":"string","format":"date-time"}}},
    "outcome_horizon": {"type":"object","additionalProperties":false,"required":["status","matures_at","evidence_refs"],"properties":{"status":{"enum":["mature","immature","unavailable","stale"]},"matures_at":{"type":"string","format":"date-time"},"evidence_refs":{"type":"array","items":{"type":"string"}}}},
    "drift": {"type":"object","additionalProperties":false,"required":["status","observed_delta","baseline_ref","evidence_refs"],"properties":{"status":{"enum":["available","insufficient","exceeds_tolerance","unavailable"]},"observed_delta":{"type":"number","minimum":0},"baseline_ref":{"type":["string","null"]},"evidence_refs":{"type":"array","items":{"type":"string"}}}},
    "migration": {"type":"object","additionalProperties":false,"required":["canonical_contract","legacy_aliases"],"properties":{"canonical_contract":{"type":"string"},"legacy_aliases":{"type":"array","items":{"type":"string"}}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["work_request_id", "plan_revision_digest", "state_version", "canonical_record_digest", "accepted_resource_revisions", "projection_digest", "risk_class", "lifecycle"], "properties": {"work_request_id": {"type": "string"}, "plan_revision_digest": {"$ref": "#/$defs/digest"}, "state_version": {"type": "integer", "minimum": 1}, "canonical_record_digest": {"$ref": "#/$defs/digest"}, "accepted_resource_revisions":{"type":"array","items":{"$ref":"#/$defs/accepted_resource_revision"}}, "projection_digest": {"$ref": "#/$defs/digest"}, "risk_class":{"pattern":"^R[0-6]$"}, "lifecycle":{"enum":["rehearsal","change","experiment","launch"]}}},
    "accepted_resource_revision": {"type":"object","additionalProperties":false,"required":["resource_ref","revision_ref","digest"],"properties":{"resource_ref":{"type":"string"},"revision_ref":{"type":"string"},"digest":{"$ref":"#/$defs/digest"}}},
    "case_set": {"type": "object", "additionalProperties": false, "required": ["case_set_id", "version", "refresh_state", "production_trace_review", "golden_sets"], "properties": {"case_set_id": {"type": "string"}, "version": {"type": "string"}, "refresh_state": {"enum": ["current_synthetic", "current_redacted", "refresh_due", "unknown"]}, "production_trace_review": {"enum":["unavailable_no_production_traces","redacted_production_review"]},"golden_sets":{"type":"array","items":{"$ref":"#/$defs/golden_set"}}}},
    "taxonomy": {"type": "object", "additionalProperties": false, "required": ["taxonomy_version", "refresh_state", "production_trace_review", "unknown_posture", "failure_modes"], "properties": {"taxonomy_version": {"type": "string"}, "refresh_state": {"enum": ["current_synthetic", "current_redacted", "refresh_due", "unknown"]}, "production_trace_review": {"enum":["unavailable_no_production_traces","redacted_production_review"]},"unknown_posture":{"const":"unclassified_requires_triage"}, "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["failure_mode_id", "parent_id", "class_name", "status", "affected_stages", "affected_dimensions", "evidence_refs", "provenance", "refresh_state"], "properties": {"failure_mode_id": {"type": "string"}, "parent_id": {"type": ["string", "null"]}, "class_name": {"type": "string"}, "status": {"enum": ["active", "unclassified", "retired"]}, "affected_stages": {"type": "array", "items": {"type": "string"}}, "affected_dimensions": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "provenance": {"enum": ["synthetic_fixture", "behavior_audit", "human_correction", "production_defect", "security_incident", "negative_knowledge", "accepted_outcome"]}, "refresh_state": {"enum": ["current_synthetic", "current_redacted", "refresh_due", "unknown"]}}}}}},
    "golden_set": {"type":"object","additionalProperties":false,"required":["golden_set_ref","workflow_lane","risk_class","split","case_ids"],"properties":{"golden_set_ref":{"type":"string"},"workflow_lane":{"type":"string"},"risk_class":{"pattern":"^R[0-6]$"},"split":{"enum":["development","held_out","canary"]},"case_ids":{"type":"array","items":{"type":"string"}}}},
    "lifecycle_event": {"type":"object","additionalProperties":false,"required":["from","to","evidence_ref"],"properties":{"from":{"enum":["proposed","triaged","accepted","retired"]},"to":{"enum":["proposed","triaged","accepted","retired"]},"evidence_ref":{"type":"string"}}},
    "calibration": {"type":"object","additionalProperties":false,"required":["status","calibration_ref","sample_count"],"properties":{"status":{"enum":["calibrated","uncalibrated","not_applicable"]},"calibration_ref":{"type":["string","null"]},"sample_count":{"type":"integer","minimum":0}}},
    "evaluator_result": {"type":"object","additionalProperties":false,"required":["kind","evaluator_ref","rubric_ref","provenance","calibration","lower_bound_evidence_ref","status","confidence","critical","independence_state","evidence_refs","human_accepted"],"properties":{"kind":{"enum":["deterministic","judge","human_acceptance"]},"evaluator_ref":{"type":"string"},"rubric_ref":{"type":"string"},"provenance":{"enum":["synthetic_fixture","redacted_evidence","human_labeled_sample"]},"calibration":{"$ref":"#/$defs/calibration"},"lower_bound_evidence_ref":{"type":["string","null"]},"status":{"enum":["passed","failed","blocked","unknown"]},"confidence":{"enum":["high","medium","low","unknown"]},"critical":{"type":"boolean"},"independence_state":{"enum":["independent","same_actor","not_required"]},"evidence_refs":{"type":"array","items":{"type":"string"}},"human_accepted":{"type":"boolean"}}},
    "telemetry": {"type":"object","additionalProperties":false,"required":["latency_ms","cost_usd","usage","recovery_count","intervention_count","reset_tax"],"properties":{"latency_ms":{"type":"number","minimum":0},"cost_usd":{"type":"number","minimum":0},"usage":{"type":"object","additionalProperties":false,"required":["input_tokens","output_tokens","cached_input_tokens"],"properties":{"input_tokens":{"type":"number","minimum":0},"output_tokens":{"type":"number","minimum":0},"cached_input_tokens":{"type":"number","minimum":0}}},"recovery_count":{"type":"number","minimum":0},"intervention_count":{"type":"number","minimum":0},"reset_tax":{"type":"object","additionalProperties":false,"required":["context_reconstruction_ms","duplicated_tool_calls","repeated_failed_approach_count","human_correction_count","switch_overhead_ms"],"properties":{"context_reconstruction_ms":{"type":"number","minimum":0},"duplicated_tool_calls":{"type":"number","minimum":0},"repeated_failed_approach_count":{"type":"number","minimum":0},"human_correction_count":{"type":"number","minimum":0},"switch_overhead_ms":{"type":"number","minimum":0}}}}},
    "tool_context": {"type":"object","additionalProperties":false,"required":["eligible_count","exposed_count","selected_count","used_count","provenance"],"properties":{"eligible_count":{"type":"integer","minimum":0},"exposed_count":{"type":"integer","minimum":0},"selected_count":{"type":"integer","minimum":0},"used_count":{"type":"integer","minimum":0},"provenance":{"type":"string"}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["case_id", "rung", "phase_id", "workflow_lane", "risk_class", "split", "golden_set_ref", "target_golden_set_ref", "case_provenance", "case_kind", "human_label_ref", "lifecycle", "lifecycle_history", "job_stages", "adapter_configuration", "evaluator_version", "evidence_refs", "refresh_state", "diagnosis_required"], "properties": {"case_id": {"type": "string"}, "rung": {"enum": ["smoke", "regression", "hill_climb", "launch"]}, "phase_id": {"type": "string"}, "workflow_lane":{"type":"string"}, "risk_class":{"pattern":"^R[0-6]$"},"split":{"enum":["development","held_out","canary"]},"golden_set_ref":{"type":["string","null"]},"target_golden_set_ref":{"type":["string","null"]},"case_provenance":{"enum":["synthetic_fixture","human_correction","production_defect","security_incident","negative_knowledge","accepted_outcome"]},"case_kind":{"enum":["task","evaluator_quality"]},"human_label_ref":{"type":["string","null"]},"lifecycle":{"enum":["proposed","triaged","accepted","retired"]},"lifecycle_history":{"type":"array","items":{"$ref":"#/$defs/lifecycle_event"}}, "job_stages": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "adapter_configuration": {"type": "object"}, "evaluator_version": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "refresh_state": {"enum": ["current_synthetic", "current_redacted", "refresh_due", "unknown"]}, "diagnosis_required": {"type": "boolean"}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["result_id", "case_id", "rung", "attempt_id", "status", "confidence", "evidence_refs", "dimension_results", "stage_results", "telemetry", "evaluator_results", "failure_mode_ids"], "properties": {"result_id": {"type": "string"}, "case_id": {"type": "string"}, "rung": {"enum": ["smoke", "regression", "hill_climb", "launch"]}, "attempt_id": {"type": "string"}, "status": {"enum": ["passed", "failed", "blocked", "unknown"]}, "confidence": {"enum": ["high", "medium", "low", "unknown"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "dimension_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["dimension_id", "status", "direction_vs_baseline", "critical", "evidence_refs"], "properties": {"dimension_id": {"type": "string"}, "status": {"enum": ["passed", "failed", "blocked", "unknown"]}, "direction_vs_baseline": {"enum": ["improved", "equivalent", "regressed", "not_compared"]}, "critical":{"type":"boolean"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}}}, "stage_results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["stage_id", "status", "dimension_ids", "evidence_refs"], "properties": {"stage_id": {"type": "string"}, "status": {"enum": ["passed", "failed", "blocked", "unknown"]}, "dimension_ids": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}}}, "telemetry": {"$ref":"#/$defs/telemetry"}, "evaluator_results":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evaluator_result"}}, "failure_mode_ids": {"type": "array", "items": {"type": "string"}}}},
    "comparison": {"type": "object", "additionalProperties": false, "required": ["comparison_id", "baseline_result_id", "candidate_result_id", "required_dimensions", "dimension_tolerances", "evidence_required", "promotion_state"], "properties": {"comparison_id": {"type": "string"}, "baseline_result_id": {"type": "string"}, "candidate_result_id": {"type": "string"}, "required_dimensions": {"type": "array", "items": {"type": "string"}}, "dimension_tolerances": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["dimension_id", "required_status", "accepted_directions"], "properties": {"dimension_id": {"type": "string"}, "required_status": {"enum": ["passed", "failed", "blocked", "unknown"]}, "accepted_directions": {"type": "array", "items": {"enum": ["improved", "equivalent", "regressed", "not_compared"]}}}}}, "evidence_required": {"type": "boolean"}, "promotion_state": {"enum": ["eligible_for_human_review", "not_eligible", "blocked"]}}},
    "experiment": {"type": "object", "additionalProperties": false, "required": ["experiment_id", "primary_dimension", "baseline_result_id", "hypothesis", "non_regression_dimensions", "phase_id", "session_affinity", "switch_condition", "tool_context", "result"], "properties": {"experiment_id": {"type": "string"}, "primary_dimension": {"type": "string"}, "baseline_result_id": {"type": "string"}, "hypothesis": {"type": "string"}, "non_regression_dimensions": {"type": "array", "items": {"type": "string"}}, "phase_id": {"type": "string"}, "session_affinity": {"enum": ["required", "preferred", "none"]}, "switch_condition": {"const": "verified_checkpoint"}, "tool_context": {"$ref":"#/$defs/tool_context"}, "result": {"enum": ["passed", "failed", "blocked", "unknown"]}}},
    "behavior_finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "root_cause_key", "failure_mode_id", "evidence_refs"], "properties": {"finding_id": {"type": "string"}, "root_cause_key": {"type": "string"}, "failure_mode_id": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}}
  }
}
