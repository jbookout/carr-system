{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "carr://control-room/contracts/job-passport-eval-portfolio.v1.schema.json",
  "version": "1.0.0",
  "status": "phase1_contract_foundation_not_deployed",
  "title": "CARR Job Passport Evaluation Portfolio v1",
  "description": "Offline, evidence-bound evaluation ladder. This is not a routing or promotion authority and deliberately defines no aggregate score.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "portfolio_id", "data_class", "generated_at", "binding", "case_set", "taxonomy", "cases", "results", "frontier_comparisons", "experiments", "behavior_findings", "notes"],
  "properties": {
    "schema_version": {"const": "job-passport-eval-portfolio.v1"},
    "portfolio_id": {"type": "string", "minLength": 1},
    "data_class": {"const": "synthetic_only"},
    "generated_at": {"type": "string", "format": "date-time"},
    "binding": {"$ref": "#/$defs/binding"},
    "case_set": {"$ref": "#/$defs/case_set"},
    "taxonomy": {"$ref": "#/$defs/taxonomy"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}},
    "frontier_comparisons": {"type": "array", "items": {"$ref": "#/$defs/comparison"}},
    "experiments": {"type": "array", "items": {"$ref": "#/$defs/experiment"}},
    "behavior_findings": {"type": "array", "items": {"$ref": "#/$defs/behavior_finding"}},
    "notes": {"type": "string"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["work_request_id", "plan_revision_digest", "state_version", "canonical_record_digest", "projection_digest"], "properties": {"work_request_id": {"type": "string"}, "plan_revision_digest": {"$ref": "#/$defs/digest"}, "state_version": {"type": "integer", "minimum": 1}, "canonical_record_digest": {"$ref": "#/$defs/digest"}, "projection_digest": {"$ref": "#/$defs/digest"}}},
    "case_set": {"type": "object", "additionalProperties": false, "required": ["case_set_id", "version", "refresh_state", "production_trace_review"], "properties": {"case_set_id": {"type": "string"}, "version": {"type": "string"}, "refresh_state": {"enum": ["current_synthetic", "refresh_due", "unknown"]}, "production_trace_review": {"const": "unavailable_no_production_traces"}}},
    "taxonomy": {"type": "object", "additionalProperties": false, "required": ["taxonomy_version", "refresh_state", "production_trace_review", "failure_modes"], "properties": {"taxonomy_version": {"type": "string"}, "refresh_state": {"enum": ["current_synthetic", "refresh_due", "unknown"]}, "production_trace_review": {"const": "unavailable_no_production_traces"}, "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["failure_mode_id", "parent_id", "class_name", "status", "affected_stages", "affected_dimensions", "evidence_refs", "provenance", "refresh_state"], "properties": {"failure_mode_id": {"type": "string"}, "parent_id": {"type": ["string", "null"]}, "class_name": {"type": "string"}, "status": {"enum": ["active", "unclassified", "retired"]}, "affected_stages": {"type": "array", "items": {"type": "string"}}, "affected_dimensions": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "provenance": {"enum": ["synthetic_fixture", "behavior_audit"]}, "refresh_state": {"enum": ["current_synthetic", "refresh_due", "unknown"]}}}}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["case_id", "rung", "phase_id", "job_stages", "adapter_configuration", "evaluator_version", "evidence_refs", "refresh_state", "diagnosis_required"], "properties": {"case_id": {"type": "string"}, "rung": {"enum": ["smoke", "regression", "hill_climb", "launch"]}, "phase_id": {"type": "string"}, "job_stages": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "adapter_configuration": {"type": "object"}, "evaluator_version": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "refresh_state": {"enum": ["current_synthetic", "refresh_due", "unknown"]}, "diagnosis_required": {"type": "boolean"}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["result_id", "case_id", "rung", "attempt_id", "status", "confidence", "evidence_refs", "dimension_results", "stage_results", "telemetry", "failure_mode_ids"], "properties": {"result_id": {"type": "string"}, "case_id": {"type": "string"}, "rung": {"enum": ["smoke", "regression", "hill_climb", "launch"]}, "attempt_id": {"type": "string"}, "status": {"enum": ["passed", "failed", "blocked", "unknown"]}, "confidence": {"enum": ["high", "medium", "low", "unknown"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "dimension_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["dimension_id", "status", "direction_vs_baseline", "evidence_refs"], "properties": {"dimension_id": {"type": "string"}, "status": {"enum": ["passed", "failed", "blocked", "unknown"]}, "direction_vs_baseline": {"enum": ["improved", "equivalent", "regressed", "not_compared"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}}}, "stage_results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["stage_id", "status", "dimension_ids", "evidence_refs"], "properties": {"stage_id": {"type": "string"}, "status": {"enum": ["passed", "failed", "blocked", "unknown"]}, "dimension_ids": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}}}, "telemetry": {"type": "object"}, "failure_mode_ids": {"type": "array", "items": {"type": "string"}}}},
    "comparison": {"type": "object", "additionalProperties": false, "required": ["comparison_id", "baseline_result_id", "candidate_result_id", "required_dimensions", "dimension_tolerances", "evidence_required", "promotion_state"], "properties": {"comparison_id": {"type": "string"}, "baseline_result_id": {"type": "string"}, "candidate_result_id": {"type": "string"}, "required_dimensions": {"type": "array", "items": {"type": "string"}}, "dimension_tolerances": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["dimension_id", "required_status", "accepted_directions"], "properties": {"dimension_id": {"type": "string"}, "required_status": {"enum": ["passed", "failed", "blocked", "unknown"]}, "accepted_directions": {"type": "array", "items": {"enum": ["improved", "equivalent", "regressed", "not_compared"]}}}}}, "evidence_required": {"type": "boolean"}, "promotion_state": {"enum": ["eligible_for_human_review", "not_eligible", "blocked"]}}},
    "experiment": {"type": "object", "additionalProperties": false, "required": ["experiment_id", "primary_dimension", "baseline_result_id", "hypothesis", "non_regression_dimensions", "phase_id", "session_affinity", "switch_condition", "tool_context", "result"], "properties": {"experiment_id": {"type": "string"}, "primary_dimension": {"type": "string"}, "baseline_result_id": {"type": "string"}, "hypothesis": {"type": "string"}, "non_regression_dimensions": {"type": "array", "items": {"type": "string"}}, "phase_id": {"type": "string"}, "session_affinity": {"enum": ["required", "preferred", "none"]}, "switch_condition": {"const": "verified_checkpoint"}, "tool_context": {"type": "object"}, "result": {"enum": ["passed", "failed", "blocked", "unknown"]}}},
    "behavior_finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "root_cause_key", "failure_mode_id", "evidence_refs"], "properties": {"finding_id": {"type": "string"}, "root_cause_key": {"type": "string"}, "failure_mode_id": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}}
  }
}
