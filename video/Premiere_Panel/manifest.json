{
    "manifestVersion": 5,
    "id": "com.carr.pipeline.panel",
    "name": "CARR Pipeline",
    "version": "0.1.0",
    "main": "index.html",
    "host": {
        "app": "premierepro",
        "minVersion": "25.6"
    },
    "requiredPermissions": {
        "localFileSystem": "fullAccess"
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "carrPipelinePanel",
            "label": { "default": "CARR Pipeline" },
            "minimumSize": { "width": 260, "height": 300 },
            "preferredDockedSize": { "width": 300, "height": 400 }
        }
    ],
    "icons": []
}
