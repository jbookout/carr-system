{
  "contract": "carr-workspace-notification-event-taxonomy",
  "version": "1.0.0",
  "status": "phase0_candidate",
  "notification_policy": {
    "authoritative_inbox": "in_app_notification_center",
    "delivery_channels": ["in_app", "web_push", "apns", "weekday_digest"],
    "badge_meaning": "unresolved human decisions, not activity count",
    "deduplication_key": ["principal_id", "owner_object_ref", "decision_or_failure_type"],
    "weekend_rule": "No Saturday or Sunday expected-work pushes; Monday digest absorbs weekend backlog.",
    "quiet_hours": "OPEN-NOTIFY-001",
    "excluded_topic": "Named lead outreach reminders remain exclusively on the Lead Board."
  },
  "notification_matrix": [
    {"class": "urgent", "topics": ["critical_deal_date", "recording_failure", "call_processing_failure", "imminent_tour_schedule_break"], "default_channels": ["in_app", "web_push", "apns"], "requires": ["why_interrupted", "exact_object_deep_link", "accountable_owner", "dedupe_key"], "weekend": "only safety or truly imminent deadlines after Joe/Dell approval of urgent matrix"},
    {"class": "review_needed", "topics": ["call_pack_ready", "draft_approval", "action_confirmation", "engineering_request_needs_answer", "engineering_request_completed", "sync_conflict"], "default_channels": ["in_app"], "optional_channels": ["web_push", "apns"], "requires": ["exact decision", "owner module", "deep link", "deadline if real"]},
    {"class": "digest", "topics": ["weekday_summary", "calm_change_summary", "nonurgent_failures"], "default_channels": ["in_app", "weekday_digest"], "requires": ["deduplicated owner-module groups"], "weekend": "suppressed"}
  ],
  "event_envelope": {
    "required": ["event_id", "event_name", "occurred_at", "tenant_id", "actor_id", "actor_type", "object_type", "object_id", "correlation_id", "source", "environment", "outcome", "redaction_profile"],
    "optional": ["causation_id", "requirement_ids", "risk_class", "previous_state", "new_state", "workflow_id", "workflow_version_id", "freshness", "safe_error_code", "duration_ms", "device_class"],
    "forbidden": ["secret", "credential", "raw_audio", "raw_transcript", "email_body", "document_body", "hidden_reasoning"]
  },
  "events": [
    {"name": "workspace.session.authenticated", "category": "security", "outcomes": ["success", "refused"], "test_ids": ["SEC-AUTH-001"]},
    {"name": "workspace.authorization.refused", "category": "security", "outcomes": ["refused"], "test_ids": ["SEC-AUTHZ-001"]},
    {"name": "workspace.route.viewed", "category": "product", "outcomes": ["rendered", "partial", "stale", "offline", "unauthorized", "failed"], "test_ids": ["OBS-ROUTE-001"]},
    {"name": "workspace.metric.deep_linked", "category": "product", "outcomes": ["resolved", "failed"], "test_ids": ["CC-FLOW-001"]},
    {"name": "workspace.work_record.parked", "category": "business_change", "outcomes": ["verified", "refused", "conflict", "failed"], "test_ids": ["DEAL-PARK-001", "DEAL-PARK-002"]},
    {"name": "workspace.work_record.restored", "category": "business_change", "outcomes": ["verified", "refused", "conflict", "failed"], "test_ids": ["DEAL-RESTORE-001"]},
    {"name": "workspace.lead.touch_logged", "category": "business_change", "outcomes": ["verified", "conflict", "failed"], "test_ids": ["LEAD-TOUCH-001"]},
    {"name": "workspace.lead.converted", "category": "business_change", "outcomes": ["verified", "duplicate_refused", "ambiguous_refused", "failed"], "test_ids": ["LEAD-CONVERT-001"]},
    {"name": "workspace.call.consent_confirmed", "category": "privacy", "outcomes": ["confirmed", "cancelled"], "test_ids": ["CALL-CONSENT-001"]},
    {"name": "workspace.call.capture_state_changed", "category": "capture", "outcomes": ["recording", "paused", "stopped", "failed"], "test_ids": ["CALL-CAPTURE-001"]},
    {"name": "workspace.call.review_ready", "category": "workflow", "outcomes": ["ready", "needs_attention", "failed"], "test_ids": ["CALL-REVIEW-001"]},
    {"name": "workspace.call.candidate_dispositioned", "category": "business_change", "outcomes": ["confirmed", "edited", "skipped", "rejected", "failed"], "test_ids": ["CALL-REVIEW-002"]},
    {"name": "workspace.call.retention_changed", "category": "privacy", "outcomes": ["purge_eligible", "purged", "blocked", "legal_hold"], "test_ids": ["CALL-RET-001"]},
    {"name": "workspace.doc.proposal_created", "category": "ai", "outcomes": ["proposed", "refused", "ambiguous"], "test_ids": ["DOC-PROP-001", "AI-SAFE-001"]},
    {"name": "workspace.engineering_request.state_changed", "category": "workflow", "outcomes": ["queued", "claimed", "in_progress", "needs_answer", "completed", "declined", "failed"], "test_ids": ["DOC-ENG-001"]},
    {"name": "workspace.tour.route_proposed", "category": "tour", "outcomes": ["proposed", "constraint_warning", "failed"], "test_ids": ["TOUR-ROUTE-001"]},
    {"name": "workspace.tour.sync_state_changed", "category": "sync", "outcomes": ["local", "uploading", "synced", "needs_review", "failed_retry"], "test_ids": ["TOUR-SYNC-001"]},
    {"name": "workspace.notification.delivery_attempted", "category": "notification", "outcomes": ["delivered", "deduplicated", "quiet_hours_suppressed", "weekend_suppressed", "failed"], "test_ids": ["NOTIFY-001"]},
    {"name": "workspace.state_transition.refused", "category": "security", "outcomes": ["refused"], "test_ids": ["STATE-REFUSE-001"]},
    {"name": "workspace.write.verified", "category": "audit", "outcomes": ["read_back_match", "read_back_mismatch", "conflict", "failed"], "test_ids": ["CONTRACT-WRITE-001"]},
    {"name": "workspace.tenant_scope.refused", "category": "security", "outcomes": ["refused"], "test_ids": ["TENANT-DENIAL-FIXTURE-001", "TENANT-CROSS-DENIAL-001"]},
    {"name": "workspace.workflow.lifecycle_changed", "category": "workflow_governance", "outcomes": ["promoted", "rolled_back", "retired", "refused"], "test_ids": ["WORKFLOW-CONTRACT-001", "WORKFLOW-PROMOTION-001"]},
    {"name": "workspace.workflow.promoted", "category": "workflow_governance", "outcomes": ["pilot", "approved", "standard", "refused"], "test_ids": ["WORKFLOW-CONTRACT-001", "WORKFLOW-PROMOTION-001"]},
    {"name": "workspace.workflow.retired", "category": "workflow_governance", "outcomes": ["retired", "refused"], "test_ids": ["WORKFLOW-CONTRACT-001", "WORKFLOW-PROMOTION-001"]},
    {"name": "workspace.maintenance.time_recorded", "category": "maintenance_accounting", "outcomes": ["normal_internal", "exception", "classification_corrected"], "test_ids": ["MAINTENANCE-CONTRACT-001", "MAINTENANCE-MEASURE-001"]},
    {"name": "workspace.maintenance.toil_triggered", "category": "maintenance_accounting", "outcomes": ["triggered_after_two_consecutive_over_five_normal_months"], "test_ids": ["MAINTENANCE-CONTRACT-001", "MAINTENANCE-MEASURE-001"]},
    {"name": "workspace.maintenance.remedy_opened", "category": "maintenance_accounting", "outcomes": ["prioritized_toil_reduction_work_opened"], "test_ids": ["MAINTENANCE-CONTRACT-001", "MAINTENANCE-MEASURE-001"]}
  ]
}
