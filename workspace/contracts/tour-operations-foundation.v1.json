{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.doctorcre.com/workspace/tour-operations-foundation.v1.json",
  "contract": "carr-tour-operations-foundation",
  "version": "1.0.0",
  "status": "foundation_contract_not_a_client_surface",
  "canonical_record_policy": {
    "source_of_truth": "versioned CARR records; projections, map providers, geocoders, routes, exports, and models are never canonical facts",
    "required_fact_metadata": ["property_id", "field_key", "value", "source_evidence_id", "observed_at", "effective_from", "effective_to", "rights_receipt_id", "confidence", "data_classification", "review_state"],
    "time_policy": "observation time records when CARR saw a claim; effective interval records when the claim is asserted to apply; open effective_to means currently asserted, never permanently true",
    "conflict_policy": "conflicting active assertions coexist visibly; a consumer chooses only a reviewed assertion and preserves the losing assertion plus resolution receipt",
    "classification": ["public", "client_authorized", "internal", "restricted"],
    "review_state": ["unreviewed", "reviewed", "conflicted", "superseded", "withdrawn"]
  },
  "entities": {
    "Property": {"identity": ["property_id", "organization_tenant_id"], "required": ["canonical_name", "canonical_address", "property_status"]},
    "SourceEvidence": {"identity": ["source_evidence_id", "organization_tenant_id"], "required": ["stable_locator", "evidence_class", "retrieved_at", "retrieval_status", "content_digest", "rights_receipt_id", "data_classification"]},
    "FieldAssertion": {"identity": ["field_assertion_id", "property_id", "field_key"], "required": ["value", "source_evidence_id", "observed_at", "effective_from", "confidence", "data_classification", "review_state"]},
    "RightsReceipt": {"identity": ["rights_receipt_id", "organization_tenant_id"], "required": ["provider", "terms_url", "reviewed_at", "reviewer", "storage_class", "storable_fields", "retention_limit", "purge_rule", "attribution", "map_compatibility", "export_exit_path", "quota_cost_gate", "status"]},
    "Tour": {"identity": ["tour_id", "organization_tenant_id"], "required": ["tour_name", "tour_status", "route_version", "canonical_dataset_version"]},
    "PublicTourProjection": {"identity": ["projection_id", "tour_id", "projection_version"], "required": ["facts_only", "public_property_ids", "render_payload", "source_freshness", "projection_digest", "status"], "forbidden": ["recommendation", "internal_contact", "internal_note", "broker_opinion", "client_requirement", "share_grant_secret"]},
    "CheatSheetRevision": {"identity": ["cheat_sheet_revision_id", "tour_id", "revision_number"], "required": ["content", "editor_actor_id", "created_at", "status"], "rule": "editable internal material is append-only revision data; it cannot mutate canonical fact assertions or a published projection"},
    "ShareGrant": {"identity": ["share_grant_id", "projection_id"], "required": ["token_digest", "audience", "created_at", "expires_at", "status"], "rule": "only a digest of an unguessable token is stored; revocation and rotation are explicit states"},
    "QualityFinding": {"identity": ["qc_finding_id", "artifact_type", "artifact_id"], "required": ["check_id", "severity", "state", "evidence", "created_at"], "rule": "QC can block or quarantine an artifact but cannot alter facts, approve publication, or dismiss its own finding"},
    "Publication": {"identity": ["publication_id", "projection_id"], "required": ["publication_state", "projection_digest", "created_at"], "rule": "publication state is actor-neutral and auditable; a client/public release requires all mandatory QC findings resolved and the applicable promotion receipt"}
  },
  "public_projection_policy": {
    "only_client_facing_read_model": "PublicTourProjection",
    "facts_only": true,
    "allowed_property_fields": ["canonical_name", "canonical_address", "suite", "property_type", "size", "asking_economics", "availability", "parking", "access", "photos", "floor_plan", "source_attribution", "as_of", "caveat"],
    "explicitly_excluded": ["broker_recommendation", "ranking", "internal_contact", "listing_agent_contact", "internal_note", "client_requirements", "source_credentials", "share_token", "audit_detail"],
    "parity_rule": "web packet, map cards, ordered itinerary, and PDF render from the same approved PublicTourProjection version; a PDF must have exactly one property page per selected property or fail QC"
  },
  "state_machines": {
    "share_grant": ["active", "revoked", "expired", "rotated"],
    "projection": ["draft", "qc_blocked", "approved", "published", "superseded", "quarantined", "rolled_back"],
    "publication": ["draft", "pending_qc", "approved", "published", "quarantined", "rolled_back"],
    "qc_finding": ["open", "accepted_risk", "resolved", "superseded"]
  },
  "non_goals": ["MLS or CoStar ingestion", "client UI", "map renderer", "PDF renderer", "native iPad application", "autonomous publication"],
  "governing_contracts": ["workspace/contracts/market-map-route-planning.v1.json", "workspace/contracts/business-entity-api-contracts.v1.json", "workspace/contracts/retention-redaction.v1.json"]
}
